{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DATABASE;Database=DATABASE_NAME;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "AutoMigrateAndSeed": true
  },
  "Features": {
    "AadhaarVerificationRequired": false
  },
  "Biometric": {
    "AllowMockProvider": true,
    "Provider": "Mock",
    "ProviderName": "Biometric Device",
    "BaseUrl": "",
    "ApiKey": "",
    "StartPath": "enrollment/start",
    "FingerPath": "enrollment/finger",
    "CompletePath": "enrollment/complete",
    "VerifyPath": "enrollment/verify"
  },
  "Identity": {
    "AllowMockProvider": false
  },
  "AclSms": {
    "BaseUrl": "https://push3.aclgateway.com/servlet/com.aclwireless.pushconnectivity.listeners.TextListener",
    "AppId": "",
    "UserId": "",
    "Password": "",
    "Sender": "",
    "DltTemplateId": ""
  },
  "OTP": {
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "MaxResendCount": 3
  },
  "Registration": {
    "SessionExpiryMinutes": 60
  },
  "Development": {
    "ShowOtpInLogs": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://192.168.31.152:3000",
      "http://192.0.0.2:3000",
      "http://192.0.0.4:3000"
    ]
  }
}

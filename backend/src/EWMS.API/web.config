<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for hosting EWMS.API under IIS via ASP.NET Core Module (ANCM).
  This file is regenerated automatically by `dotnet publish`; kept here as a
  reference / fallback. Adjust the arguments path if your DLL name differs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\EWMS.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
